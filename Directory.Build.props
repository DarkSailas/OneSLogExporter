<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_</PathMap>
    <!-- Выносим директории bin и obj во временный каталог для исключения файловых блокировок cloud sync (Google Drive, OneDrive и др.) -->
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\Temp\OneSLogExporterBuild\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\Temp\OneSLogExporterBuild\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- Отключение мусорных сателлитных папок локализации (cs, de, es, fr, ru, etc.) -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <Version>2.3.0</Version>
    <FileVersion>2.3.0.0</FileVersion>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <Product>OneSLogExporter</Product>
    <Company>DarkSailas</Company>
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632;CS1998</NoWarn>
  </PropertyGroup>
</Project>
