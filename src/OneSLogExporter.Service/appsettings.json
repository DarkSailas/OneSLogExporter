{
  // ============================================================================
  // OneSLogExporter — Утилита экспорта и логирования 1С (.NET 10)
  // ============================================================================

  // --------------------------------------------------------------------------
  // НАСТРОЙКИ ДЕБАГ-ЛОГИРОВАНИЯ ПРИЛОЖЕНИЯ (Serilog)
  // Уровень: Error (логируются исключительно сбои и ошибки)
  // --------------------------------------------------------------------------
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },

  "Exporter": {
    // --------------------------------------------------------------------------
    // ОБЩИЕ НАСТРОЙКИ СЛУЖБЫ
    // --------------------------------------------------------------------------
    "PollingIntervalSeconds": 60,       // Интервал опроса логов 1С по таймеру (в секундах)
    "StateFilePath": "state.json",       // Файл трекинга позиции чтения логов (защита от дублей)

    // --------------------------------------------------------------------------
    // ВЫГРУЗКА РАСПАРСЕННЫХ JSON ЛОГОВ В ФАЙЛЫ НА ДИСКЕ (FileDump)
    // --------------------------------------------------------------------------
    "FileDump": {
      "TechLogEnabled": true,          // Выгрузка в локальный JSON Технологического Журнала (true = включено, false = отключено)
      "EventLogEnabled": true,         // Выгрузка в локальный JSON Журнала Регистрации (true = включено, false = отключено)
      "TechLogDirectoryPath": "C:/1C_Export/json_dump/techlog",   // ОБЯЗАТЕЛЬНЫЙ каталог выгрузки JSON ТЖ (изоляция 1С от блокировок)
      "EventLogDirectoryPath": "C:/1C_Export/json_dump/eventlog", // ОБЯЗАТЕЛЬНЫЙ каталог выгрузки JSON ЖР (изоляция 1С от блокировок)
      "TechLogFileNamePattern": "data_tglog_{N}.json",   // Маска имени файлов ТЖ (слоты data_tglog_1.json .. data_tglog_N.json)
      "EventLogFileNamePattern": "data_evlog_{N}.json",  // Маска имени файлов ЖР (слоты data_evlog_1.json .. data_evlog_N.json)
      "RetainedFileCountLimit": 30,     // Лимит хранимых слотов файлов в каждом каталоге (по умолчанию 30)
      "MaxTotalSizeMb": 500,           // Максимальный суммарный размер файлов в каталоге в МБ (по умолчанию 500 МБ)
      "MaxFileSizeMb": 0,              // Лимит размера одного файла дампа в МБ (0 = без ограничений)
      "MaxFileRecordCount": 0,         // Лимит числа записей/строк в одном файле (0 = без ограничений)
      "RollStrategy": "SizeOrRecordCount" // Стратегия ротации: Size (по МБ), RecordCount (по строкам), SizeOrRecordCount (по любому)
    },

    // --------------------------------------------------------------------------
    // МОНИТОРИНГ ЖУРНАЛА РЕГИСТРАЦИИ 1С (.lgp / 1Cv8.lgf / 1Cv8.lgd SQLite)
    // --------------------------------------------------------------------------
    "EventLog": {
      "Enabled": false,                // Сбор и экспорт Журнала Регистрации (по умолчанию отключен)
      "DirectStream": true,           // Direct-Stream: прямая вставка в ClickHouse/Elastic из памяти (ускорение догона в 4-5 раз)
      "FilterEmptyTransactions": true, // Исключать рутинные "Транзакция. Начало" и "Транзакция. Фиксация" (ускорение догона в 35 раз)
      "DirectoryPath": "C:/Logs/1C/reg_1541", // Каталог с файлами ЖР (ВАЖНО: прямые слеши '/' например "C:/Logs/1C/reg_1541" либо '\\\\')
      "DatabaseName": "demo_db",       // Имя информационной базы в кластере 1С (автоматический поиск GUID и каталога логов)
      "IndexId": "prod",               // Имя базы / суффикс индекса в Elastic (events_prod_YYYYMMDD)
      "Periodicity": "h",              // Периодичность логов в 1С ("h"-часовая, "d"-дневная)
      "HourDelta": 1,                  // Глубина поиска текущих файлов логов (в часах)
      "FileName": "",                  // Явное имя файла .lgp/.lgd (пусто = автовыбор)
      "LoadArchive": false,            // false = только новые live-события при первом старте, true = читать всю историю с начала
      "Separation": "Day"              // Гранулярность индексов: "Day" (D), "Month" (M - для небольших баз), "Hour" (H), "None" (all)
    },

    // --------------------------------------------------------------------------
    // МОНИТОРИНГ ТЕХНОЛОГИЧЕСКОГО ЖУРНАЛА 1С (.log)
    // --------------------------------------------------------------------------
    "TechLog": {
      "Enabled": true,                 // Сбор и экспорт Технологического Журнала
      "DirectStream": true,            // Direct-Stream: прямая вставка в ClickHouse/Elastic из памяти (ускорение догона в 4-5 раз)
      "FilterEmptyEvents": true,       // Исключать пустые события ТЖ с нулевой длительностью (0 мкс) и без полезной нагрузки
      "DirectoryPath": "C:/Logs/1C/techlog", // Каталог с подпапками процессов rphost_PID (ВАЖНО: прямые слеши '/' например "C:/Logs/1C/techlog" либо '\\\\')
      "IndexId": "prod",               // Имя кластера / суффикс индекса в Elastic (techlog_prod_YYYYMMDD)
      "MaxAgeHours": 24,               // Максимальный возраст обрабатываемых файлов ТЖ (в часах)
      "Separation": "Day"              // Гранулярность индексов: "Day" (D), "Month" (M), "Hour" (H), "None" (all)
    },

    // --------------------------------------------------------------------------
    // ПОДКЛЮЧЕНИЕ И АВТОРИЗАЦИЯ ELASTICSEARCH / OPENSEARCH
    // --------------------------------------------------------------------------
    "Elastic": {
      "TechLogEnabled": false,         // Экспорт Технологического Журнала в Elastic (true = отправлять, false = отключить)
      "EventLogEnabled": false,        // Экспорт Журнала Регистрации в Elastic (true = отправлять, false = отключить)
      "ServerUrl": "http://localhost:9200", // HTTP/HTTPS URL кластера Elasticsearch
      "Username": "",                  // Логин Basic Auth (пусто = без авторизации)
      "Password": "",                  // Пароль Basic Auth
      "ApiKey": "",                    // API Key авторизация (альтернатива паролю)
      "EventLogIndexPrefix": "events", // Префикс индекса в Elastic для Журнала Регистрации
      "TechLogIndexPrefix": "techlog", // Префикс индекса в Elastic для Технологического Журнала
      "Separation": "Day",             // Гранулярность индексов по умолчанию: "Day" (по дням), "Month" (по месяцам)
      "AutoApplyTemplate": false,      // Автоприменение шаблона индекса при старте (по умолчанию выключено)
      "BulkBatchSize": 1000            // Размер пакета документов при bulk-отгрузке
    },

    // --------------------------------------------------------------------------
    // ВЕБ-ИНТЕРФЕЙС И ШАБЛОНЫ KIBANA / OPENSEARCH DASHBOARDS
    // --------------------------------------------------------------------------
    "Kibana": {
      "TechLogEnabled": false,         // Создание Index Pattern для Технологического Журнала
      "EventLogEnabled": false,        // Создание Index Pattern для Журнала Регистрации
      "ServerUrl": "http://localhost:5601", // URL веб-интерфейса Kibana
      "Username": "",                  // Логин Kibana
      "Password": "",                  // Пароль Kibana
      "IndexPatternEventLog": "events_*", // Шаблон индекса (Index Pattern) для Журнала Регистрации
      "IndexPatternTechLog": "techlog_*"  // Шаблон индекса (Index Pattern) для Технологического Журнала
    },

    // --------------------------------------------------------------------------
    // ПОДКЛЮЧЕНИЕ И ЭКСПОРТ В CLICKHOUSE (HTTP API / FORMAT JSONEachRow)
    // --------------------------------------------------------------------------
    "ClickHouse": {
      "TechLogEnabled": false,         // Экспорт Технологического Журнала в ClickHouse (true = писать в TechLogTable, false = отключить)
      "EventLogEnabled": false,        // Экспорт Журнала Регистрации в ClickHouse (true = писать в EventLogTable, false = отключить)
      "ServerUrl": "http://localhost:8123", // HTTP адрес ClickHouse
      "Database": "default",           // База данных в ClickHouse
      "User": "default",               // Пользователь ClickHouse
      "Password": "",                  // Пароль пользователя ClickHouse
      "TechLogTable": "techlog",       // Таблица для Технологического Журнала (MergeTree)
      "EventLogTable": "eventlog",     // Таблица для Журнала Регистрации (MergeTree)
      "BulkBatchSize": 25000,          // Размер пакета строк при вставке (25 000 для максимальной скорости ClickHouse)
      "TimeoutSeconds": 60             // Таймаут сетевых запросов (в секундах)
    }
  }
}
