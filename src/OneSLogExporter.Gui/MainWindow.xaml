                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtTgSearchUsers" TextChanged="TxtTgSearchUsers_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск пользователя..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnTgSelectAllUsers_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnTgExcludeAllUsers_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnTgClearUsers_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListTgUsers" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="ПРИЛОЖЕНИЯ">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
