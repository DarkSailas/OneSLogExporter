                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnTgSelectAllApps_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnTgExcludeAllApps_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnTgClearApps_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListTgApps" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="PID">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtTgSearchPids" TextChanged="TxtTgSearchPids_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск PID..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnTgSelectAllPids_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnTgExcludeAllPids_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnTgClearPids_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListTgPids" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="SPID">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtTgSearchSpids" TextChanged="TxtTgSearchSpids_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск SPID..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnTgSelectAllSpids_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnTgExcludeAllSpids_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnTgClearSpids_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListTgSpids" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="ПОТОК OS">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtTgSearchThreads" TextChanged="TxtTgSearchThreads_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск потока OS..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnTgSelectAllThreads_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnTgExcludeAllThreads_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnTgClearThreads_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListTgThreads" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkTgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 6. Кнопка Очистки таблицы и Счётчик записей ТЖ -->
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="BtnResetTgFilters" Content="ОЧИСТИТЬ" Click="BtnResetTgFilters_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="8,4" ToolTip="Полностью очистить таблицу ТЖ и освободить оперативную память"/>
                                        <Border Background="{StaticResource InkBlack}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="15" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtTgCountBadge" Text="0 записей" Foreground="{StaticResource EmberDiode}" FontWeight="SemiBold" FontSize="11" FontFamily="Consolas, monospace"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Панель активных фильтров ТЖ (кнопка раскрытия полного списка и сброса слева) -->
                                <StackPanel x:Name="ContainerTgFilterChips" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed">
                                    <ToggleButton x:Name="BtnTgMoreChips" Content="АКТИВНЫЕ ФИЛЬТРЫ (0) ▼" Style="{StaticResource GhostToggleButton}" Padding="8,4" FontSize="11" FontWeight="SemiBold" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=BtnTgMoreChips}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnTgMoreChips}" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource ActiveBorder}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,4,0,0" MinWidth="360" MaxWidth="640" MaxHeight="340">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="ВСЕ АКТИВНЫЕ ФИЛЬТРЫ" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <Button Grid.Column="2" HorizontalAlignment="Right" Content="СБРОСИТЬ ВСЕ" Click="BtnResetTgFilters_Click" Style="{StaticResource GhostButton}" Padding="8,2.5" FontSize="10"/>
                                                    </Grid>
                                                    <WrapPanel x:Name="PanelTgPopupChips" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                    <Button Content="СБРОСИТЬ ВСЕ" Click="BtnResetTgFilters_Click" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10.5" Margin="6,0,0,0" ToolTip="Сбросить все активные фильтры"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Таблица ТЖ с аппаратной виртуализацией для мгновенного скролла 50 000+ строк -->
                        <DataGrid x:Name="GridTg" Grid.Row="2" VerticalAlignment="Stretch" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True" Sorting="GridTg_Sorting" MouseDoubleClick="GridTg_MouseDoubleClick" MouseRightButtonDown="GridTg_MouseRightButtonDown" PreviewKeyDown="GridTg_PreviewKeyDown" Background="{StaticResource InkBlack}" RowBackground="#141414" AlternatingRowBackground="#1B1B1B" Foreground="{StaticResource PulpCream}" BorderThickness="1" BorderBrush="{StaticResource HairlineBorder}" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#242424" SelectionUnit="FullRow" SelectionMode="Extended" FocusVisualStyle="{x:Null}" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" EnableRowVirtualization="True" EnableColumnVirtualization="False">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#1C1C1C" Foreground="{StaticResource PulpCream}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                    <MenuItem Header="Скопировать значение ячейки" Click="TgMenuCopyCell_Click" InputGestureText="ПКМ"/>
                                    <MenuItem Header="Скопировать всю строку (текст)" Click="TgMenuCopyRowText_Click" InputGestureText="Ctrl+C"/>
                                    <MenuItem Header="Скопировать запись в JSON" Click="TgMenuCopyRowJson_Click"/>
                                    <MenuItem Header="Скопировать Контекст / SQL" Click="TgMenuCopyContextSql_Click"/>
                                    <Separator Background="{StaticResource HairlineBorder}"/>
                                    <MenuItem Header="Экспорт в Excel (.xlsx)" Click="TgMenuExportExcel_Click"/>
                                    <MenuItem Header="Открыть подробные детали" Click="TgMenuInspectRow_Click" FontWeight="SemiBold"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата и Время" Binding="{Binding DateFormatted}" SortMemberPath="Date" SortDirection="Descending" Width="180" MinWidth="140"/>
                                <DataGridTextColumn Header="Событие" Binding="{Binding Event}" SortMemberPath="Event" Width="110" MinWidth="70"/>
                                <DataGridTextColumn Binding="{Binding ExecutionStatus}" SortMemberPath="IsActiveOperation" Width="95" MinWidth="75">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Статус" ToolTip="Статус операции: 'Выполняется' (промежуточный срез незавершенной операции LONGDURATIONINFO) или 'Завершено' (окончание операции)"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Длительность" Binding="{Binding DurationFormatted}" SortMemberPath="DurationMs" Width="125" MinWidth="110"/>
                                <DataGridTextColumn Binding="{Binding ProcessName}" SortMemberPath="ProcessName" Width="90" MinWidth="70">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Процесс" ToolTip="Имя процесса кластера 1С: rphost (рабочий процесс), rmngr (менеджер кластера), ragent (агент сервера)"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ProcessId}" SortMemberPath="ProcessId" Width="65" MinWidth="50">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="PID" ToolTip="PID (Process ID) — номер процесса службы 1С в Диспетчере задач Windows (например rphost_7916)"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Spid}" SortMemberPath="Spid" Width="65" MinWidth="50">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="SPID" ToolTip="SPID (Server Process ID) — номер подключения к СУБД (MS SQL / PostgreSQL / dbpid). Связывает запись 1С с сессией в SSMS (sp_who2) или pg_stat_activity"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding OSThread}" SortMemberPath="OSThread" Width="135" MinWidth="120">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Поток (OSThread)" ToolTip="Поток (OSThread) — уникальный номер потока ОС внутри процесса rphost. Позволяет связать длинную цепочку срезов LONGDURATIONINFO с завершающим событием"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Пользователь" Binding="{Binding User}" SortMemberPath="User" Width="140" MinWidth="90"/>
                                <DataGridTextColumn Header="Приложение" Binding="{Binding App}" SortMemberPath="App" Width="165" MinWidth="100"/>
                                <DataGridTextColumn Header="Контекст / SQL" Binding="{Binding Context}" SortMemberPath="Context" Width="*"/>
                                <DataGridTemplateColumn Header="Действия" Width="95" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ДЕТАЛИ" Style="{StaticResource InspectButton}" Click="BtnInspectRow_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Вкладка Журнал Регистрации (ЖР) -->
                <TabItem Header="ЖУРНАЛ РЕГИСТРАЦИИ (ЖР)">
                    <Grid Margin="0,6,0,0" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель Загрузки и Парсинга ЖР -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="ПУТЬ К ЖР:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Каталог информационной базы 1С или отдельный файл Журнала Регистрации (*.lgp, 1Cv8.lgf). Поддерживается прямое указание одного файла и произвольная вложенность."/>
                            </StackPanel>
                            <TextBox x:Name="TxtLgPath" Grid.Column="1" Text="C:\Logs\LGLogs" VerticalAlignment="Center" AllowDrop="True" PreviewDragOver="TxtPath_PreviewDragOver" Drop="TxtLgPath_Drop" ToolTip="Укажите каталог или отдельный файл Журнала Регистрации (*.lgp, 1Cv8.lgf). Поддерживается Drag and Drop."/>
                            <Button x:Name="BtnBrowseLg" Grid.Column="2" Content="ОБЗОР ▾" Click="BtnBrowseLg_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0" ToolTip="Выбрать каталог или отдельный файл Журнала Регистрации">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📁 Выбрать каталог (папку)..." Click="MenuItemBrowseLgFolder_Click"/>
                                        <MenuItem Header="📄 Выбрать файл ЖР (*.lgp, 1Cv8.lgd, 1Cv8.lgf, *.lgx)..." Click="MenuItemBrowseLgFile_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                <TextBlock Text="ЛИМИТ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Ограничение количества загружаемых строк Журнала Регистрации для моментальной диагностики."/>
                            </StackPanel>
                            <ComboBox x:Name="CmbLgLimit" Grid.Column="4" Width="110" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="CmbLgLimit_SelectionChanged">
                                <ComboBoxItem Content="Все записи"/>
                                <ComboBoxItem Content="1 000"/>
                                <ComboBoxItem Content="5 000"/>
                                <ComboBoxItem Content="10 000"/>
                                <ComboBoxItem Content="50 000"/>
                                <ComboBoxItem Content="100 000"/>
                                <ComboBoxItem Content="500 000"/>
                                <ComboBoxItem Content="1 000 000"/>
                            </ComboBox>
                            <Button x:Name="BtnParseLg" Grid.Column="5" Content="РАСПАРСИТЬ ЖР" Click="BtnParseLg_Click" Style="{StaticResource PrimaryButton}" ToolTip="Запустить разбор словаря 1Cv8.lgf и параллельное чтение записей Журнала Регистрации (*.lgp)" Margin="6,0,0,0"/>
                            <Button x:Name="BtnCancelLg" Grid.Column="6" Content="ОСТАНОВИТЬ" Click="BtnCancelParsing_Click" Visibility="Collapsed" Background="#331414" Foreground="#FFFFFF" BorderBrush="#8A2B2B" BorderThickness="1" Padding="12,5" ToolTip="Остановить выполнение операции парсинга" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportLgJson" Grid.Column="7" Content="JSON" Click="BtnExportLgJson_Click" ToolTip="Экспорт выделенных строк (или всей таблицы) ЖР в JSON" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportLgExcel" Grid.Column="8" Content="EXCEL" Click="BtnExportLgExcel_Click" ToolTip="Экспорт таблицы ЖР в файл Microsoft Excel (.xlsx)" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportLgElastic" Grid.Column="9" Content="ELASTIC" Click="BtnExportLgElastic_Click" ToolTip="Экспортировать текущие отображаемые записи таблицы напрямую в кластер Elasticsearch" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportLgClickHouse" Grid.Column="10" Content="CLICKHOUSE" Click="BtnExportLgClickHouse_Click" ToolTip="Экспортировать текущие отображаемые записи таблицы напрямую в ClickHouse" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Панель Поиска, Фильтров и Сортировки ЖР -->
                        <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="10,8" Margin="0,0,0,8" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Быстрый Поиск с поддержкой исключений '!' и '-' -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox x:Name="TxtLgFilter" TextChanged="TxtLgFilter_TextChanged" Padding="8,6,8,6" FontSize="12" ToolTip="Быстрый поиск по всем полям. Для исключения используйте ! или - (например: !Сеанс, -Администратор, !Ошибка)"/>
                                    </Grid>

                                    <!-- 2. Фильтр по времени (С / По) и Календарь периода -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="ВРЕМЯ:" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                        <TextBlock Text="с" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" Margin="0,0,2,0"/>
                                        <TextBox x:Name="TxtLgTimeFrom" TextChanged="TxtLgTimeFilter_TextChanged" Width="64" ToolTip="Время С (например 16:13:00, 16:13 или 2026-08-17 16:13)" FontSize="12" Padding="4,4"/>
                                        <TextBlock Text="по" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" Margin="4,0,2,0"/>
                                        <TextBox x:Name="TxtLgTimeTo" TextChanged="TxtLgTimeFilter_TextChanged" Width="64" ToolTip="Время ПО (например 16:15:00 или 16:15)" FontSize="12" Padding="4,4"/>

                                        <!-- Интерактивный Календарь ЖР с пресетами -->
                                        <ToggleButton x:Name="BtnLgCalendarMenu" Content="📅 КАЛЕНДАРЬ ▼" Style="{StaticResource GhostToggleButton}" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click" ToolTip="Интерактивный календарь и быстрый выбор диапазона дат ЖР"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnLgCalendarMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnLgCalendarMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,4,0,0">
                                                <StackPanel Width="260">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="ВЫБОР ПЕРИОДА" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button HorizontalAlignment="Right" Content="СБРОСИТЬ" Click="BtnLgCalendarClear_Click" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10"/>
                                                    </Grid>

                                                    <!-- Подсказка двухкликового выбора периода -->
                                                    <TextBlock x:Name="TxtLgCalendarHint" Text="Кликните дату начала и дату окончания" Foreground="{StaticResource MidAsh}" FontSize="10.5" FontStyle="Italic" Margin="0,0,0,6"/>

                                                    <WrapPanel Margin="0,0,0,6">
                                                        <Button Content="Сегодня" Click="BtnLgPresetToday_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="Вчера" Click="BtnLgPresetYesterday_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="3 дня" Click="BtnLgPreset3Days_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="7 дней" Click="BtnLgPreset7Days_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="30 дней" Click="BtnLgPreset30Days_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="Этот месяц" Click="BtnLgPresetThisMonth_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="Все логи" Click="BtnLgPresetAllLogs_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,0,3"/>
                                                    </WrapPanel>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,4,0">
                                                            <TextBlock Text="Дата С:" Foreground="{StaticResource MidAsh}" FontSize="10.5" Margin="0,0,0,2"/>
                                                            <TextBox x:Name="TxtLgDateFrom" TextChanged="TxtLgDate_TextChanged" GotFocus="TxtLgDate_GotFocus" Padding="6,4" FontSize="11" ToolTip="Дата С в формате ДД.ММ.ГГГГ (например 26.08.2026)"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="Дата ПО:" Foreground="{StaticResource MidAsh}" FontSize="10.5" Margin="0,0,0,2"/>
                                                            <TextBox x:Name="TxtLgDateTo" TextChanged="TxtLgDate_TextChanged" GotFocus="TxtLgDate_GotFocus" Padding="6,4" FontSize="11" ToolTip="Дата ПО в формате ДД.ММ.ГГГГ (например 30.08.2026)"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Calendar x:Name="CalLgRange" Style="{StaticResource DarkCalendarStyle}" SelectionMode="SingleRange" SelectedDatesChanged="CalLgRange_SelectedDatesChanged" PreviewMouseUp="CalLgRange_PreviewMouseUp" GotMouseCapture="Calendar_GotMouseCapture" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="ПРИМЕНИТЬ" Click="BtnLgCalendarApply_Click" Style="{StaticResource PrimaryButton}" Padding="12,5" HorizontalAlignment="Left"/>
                                                        <Button Grid.Column="1" Content="ЗАКРЫТЬ" Click="BtnLgCalendarClose_Click" Style="{StaticResource GhostButton}" Padding="10,5"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 3. Основной фильтр событий/важности ЖР -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="ФИЛЬТР:" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CmbLgImportanceFilter" SelectionChanged="CmbLgImportanceFilter_SelectionChanged" Width="155" SelectedIndex="0">
                                            <ComboBoxItem Content="Все уровни и события"/>
                                            <ComboBoxItem Content="Ошибка"/>
                                            <ComboBoxItem Content="Предупреждение"/>
                                            <ComboBoxItem Content="Информация"/>
                                            <ComboBoxItem Content="Примечание"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 4. Меню Включающих Параметров Фильтрации ЖР -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnLgFilterMenu" Content="ДОП. ФИЛЬТРЫ ▼" Style="{StaticResource GhostToggleButton}" Padding="9,5" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnLgFilterMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnLgFilterMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,4,0,0">
                                                <StackPanel Width="360">
                                                    <TextBlock Text="ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ ФИЛЬТРАЦИИ ЖР" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" Margin="0,0,0,10"/>

                                                    <TextBlock Text="ВКЛЮЧАЮЩИЕ УРОВНИ ВАЖНОСТИ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <WrapPanel Margin="0,0,0,10">
                                                        <CheckBox x:Name="ChkLgIncError" Content="Ошибка" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkLgFilter_Click"/>
                                                        <CheckBox x:Name="ChkLgIncWarn" Content="Предупреждение" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkLgFilter_Click"/>
                                                        <CheckBox x:Name="ChkLgIncInfo" Content="Информация" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkLgFilter_Click"/>
                                                        <CheckBox x:Name="ChkLgIncNote" Content="Примечание" Foreground="{StaticResource Vapor}" Margin="0,0,0,4" Click="ChkLgFilter_Click"/>
                                                    </WrapPanel>

                                                    <TextBlock Text="СОРТИРОВКА ТАБЛИЦЫ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbLgSortPreset" SelectionChanged="CmbLgSortPreset_SelectionChanged" SelectedIndex="0">
                                                        <ComboBoxItem Content="Дата (сначала новые)"/>
                                                        <ComboBoxItem Content="Дата (сначала старые)"/>
                                                        <ComboBoxItem Content="Важность + Дата"/>
                                                        <ComboBoxItem Content="Событие + Дата"/>
                                                        <ComboBoxItem Content="Пользователь + Дата"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 5. Меню Исключающих Фильтров ЖР (НЕ) с множественным выбором -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnLgExcludeMenu" Content="ИСКЛЮЧЕНИЯ (НЕ) ▼" Style="{StaticResource GhostToggleButton}" Padding="9,5" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnLgExcludeMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnLgExcludeMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,4,0,0">
                                                <StackPanel Width="420">
                                                    <TextBlock Text="ИСКЛЮЧЕНИЕ ДАННЫХ ИЗ ЖР (ФИЛЬТРЫ НЕ)" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" Margin="0,0,0,10"/>

                                                    <!-- Исключение уровней важности -->
                                                    <TextBlock Text="ИСКЛЮЧИТЬ УРОВНИ ВАЖНОСТИ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <WrapPanel Margin="0,0,0,10">
                                                        <CheckBox x:Name="ChkLgExError" Content="Ошибки" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkLgFilter_Click"/>
                                                        <CheckBox x:Name="ChkLgExWarn" Content="Предупреждения" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkLgFilter_Click"/>
                                                        <CheckBox x:Name="ChkLgExInfo" Content="Информацию" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkLgFilter_Click"/>
                                                        <CheckBox x:Name="ChkLgExNote" Content="Примечания" Foreground="{StaticResource Vapor}" Margin="0,0,0,4" Click="ChkLgFilter_Click"/>
                                                    </WrapPanel>

                                                    <!-- Шапка секции событий ЖР с поиском и кнопками -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Исключить события ЖР:" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="СНЯТЬ ВСЕ" Click="BtnLgExcludeClearAll_Click" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBox x:Name="TxtLgExcludeEventSearch" TextChanged="TxtLgExcludeEventSearch_TextChanged" Padding="8,4" Margin="0,0,0,6" FontSize="11.5" ToolTip="Фильтр по списку событий..."/>

                                                    <!-- Скроллируемый список событий ЖР с чекбоксами -->
                                                    <Border Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Height="180" Margin="0,0,0,10">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl x:Name="ListLgExcludeEvents" Margin="6,4">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3" Click="ChkLgExcludeEventItem_Click">
                                                                            <CheckBox.Content>
                                                                                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Vapor}"/>
                                                                                    <Run Text=" — " Foreground="{StaticResource MidAsh}"/>
                                                                                    <Run Text="{Binding Subtitle}" Foreground="{StaticResource MidAsh}" FontSize="11"/>
                                                                                </TextBlock>
                                                                            </CheckBox.Content>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>

                                                    <!-- Памятка по строке поиска -->
                                                    <Border Background="#141414" CornerRadius="0" Padding="8,6" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                                        <TextBlock Foreground="{StaticResource MidAsh}" FontSize="11" TextWrapping="Wrap" LineHeight="15">
                                                            <Run FontWeight="SemiBold" Foreground="{StaticResource Vapor}">РУЧНЫЕ ИСКЛЮЧЕНИЯ:</Run> вводите в поиск <Run FontWeight="Bold" Foreground="{StaticResource EmberDiode}">!</Run> перед словом (например <Run Foreground="{StaticResource Vapor}">!Сеанс</Run>, <Run Foreground="{StaticResource Vapor}">!Администратор</Run>, <Run Foreground="{StaticResource Vapor}">!Информация</Run>).
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 6. Меню Отбора по полям ЖР (Пользователи, Приложения, Метаданные, События) -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnLgFieldsMenu" Content="ОТБОР ПО ПОЛЯМ ▼" Style="{StaticResource GhostToggleButton}" Padding="9,5" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnLgFieldsMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnLgFieldsMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,4,0,0">
                                                <StackPanel Width="560">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="ОТБОР ЗАПИСЕЙ ЖР ПО ПОЛЯМ" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="СБРОСИТЬ ВСЕ" Click="BtnLgClearAllFieldFilters_Click" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10"/>
                                                    </Grid>

                                                    <TabControl Background="Transparent" BorderThickness="0" Height="270">
                                                        <TabItem Header="ПОЛЬЗОВАТЕЛИ">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtLgSearchUsers" TextChanged="TxtLgSearchUsers_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск пользователя..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnLgSelectAllUsers_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnLgExcludeAllUsers_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnLgClearUsers_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListLgUsers" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="ПРИЛОЖЕНИЯ">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtLgSearchApps" TextChanged="TxtLgSearchApps_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск приложения..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnLgSelectAllApps_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnLgExcludeAllApps_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnLgClearApps_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListLgApps" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="МЕТАДАННЫЕ">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtLgSearchMetas" TextChanged="TxtLgSearchMetas_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск метаданных..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnLgSelectAllMetas_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnLgExcludeAllMetas_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnLgClearMetas_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListLgMetas" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>

                                                        <TabItem Header="СОБЫТИЯ">
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtLgSearchEvents" TextChanged="TxtLgSearchEvents_TextChanged" Padding="6,3" FontSize="11.5" ToolTip="Поиск события ЖР..."/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="+ ВСЕ" Click="BtnLgSelectAllEvents_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Включить все видимые"/>
                                                                        <Button Content="НЕ ВСЕ" Click="BtnLgExcludeAllEvents_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" Margin="0,0,3,0" ToolTip="Исключить все видимые"/>
                                                                        <Button Content="СНЯТЬ" Click="BtnLgClearEvents_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="9.5" ToolTip="Снять отметки"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl x:Name="ListLgEvents" Margin="6,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="1,2">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <ToggleButton IsChecked="{Binding IsInclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="ДА" Style="{StaticResource FilterIncludeToggleButton}" ToolTip="Включить в отбор (только это значение)"/>
                                                                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsExclude, Mode=TwoWay}" Click="ChkLgFieldValueItem_Click"
                                                                                                      Content="НЕ" Style="{StaticResource FilterExcludeToggleButton}" Margin="3,0,6,0" ToolTip="Исключить из отбора (скрыть это значение)"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Foreground="{StaticResource Vapor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 6. Кнопки Удаления строк, Очистки таблицы и Счётчик записей ЖР -->
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button x:Name="BtnDeleteSelectedLg" Content="УДАЛИТЬ" Click="BtnDeleteSelectedLg_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="8,4" ToolTip="Удалить выделенные строки из таблицы (Клавиша Delete, с подтверждением)"/>
                                        <Button x:Name="BtnResetLgFilters" Content="ОЧИСТИТЬ" Click="BtnResetLgFilters_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="8,4" ToolTip="Полностью очистить таблицу ЖР и освободить оперативную память"/>
                                        <Border Background="{StaticResource InkBlack}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="15" Padding="10,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtLgCountBadge" Text="0 записей" Foreground="{StaticResource EmberDiode}" FontWeight="SemiBold" FontSize="11" FontFamily="Consolas, monospace"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Панель активных фильтров ЖР (кнопка раскрытия полного списка и сброса слева) -->
                                <StackPanel x:Name="ContainerLgFilterChips" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed">
                                    <ToggleButton x:Name="BtnLgMoreChips" Content="АКТИВНЫЕ ФИЛЬТРЫ (0) ▼" Style="{StaticResource GhostToggleButton}" Padding="8,4" FontSize="11" FontWeight="SemiBold" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=BtnLgMoreChips}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnLgMoreChips}" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource ActiveBorder}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,4,0,0" MinWidth="360" MaxWidth="640" MaxHeight="340">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="ВСЕ АКТИВНЫЕ ФИЛЬТРЫ" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <Button Grid.Column="2" HorizontalAlignment="Right" Content="СБРОСИТЬ ВСЕ" Click="BtnResetLgFilters_Click" Style="{StaticResource GhostButton}" Padding="8,2.5" FontSize="10"/>
                                                    </Grid>
                                                    <WrapPanel x:Name="PanelLgPopupChips" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                    <Button Content="СБРОСИТЬ ВСЕ" Click="BtnResetLgFilters_Click" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="10.5" Margin="6,0,0,0" ToolTip="Сбросить все активные фильтры"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Таблица ЖР с аппаратной виртуализацией для мгновенного скролла 50 000+ строк -->
                        <DataGrid x:Name="GridLg" Grid.Row="2" VerticalAlignment="Stretch" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True" Sorting="GridLg_Sorting" MouseDoubleClick="GridLg_MouseDoubleClick" MouseRightButtonDown="GridLg_MouseRightButtonDown" PreviewKeyDown="GridLg_PreviewKeyDown" Background="{StaticResource InkBlack}" RowBackground="#141414" AlternatingRowBackground="#1B1B1B" Foreground="{StaticResource PulpCream}" BorderThickness="1" BorderBrush="{StaticResource HairlineBorder}" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#242424" SelectionUnit="FullRow" SelectionMode="Extended" FocusVisualStyle="{x:Null}" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item" EnableRowVirtualization="True" EnableColumnVirtualization="False">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#1C1C1C" Foreground="{StaticResource PulpCream}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                    <MenuItem Header="Скопировать значение ячейки" Click="LgMenuCopyCell_Click" InputGestureText="ПКМ"/>
                                    <MenuItem Header="Скопировать всю строку (текст)" Click="LgMenuCopyRowText_Click" InputGestureText="Ctrl+C"/>
                                    <MenuItem Header="Скопировать запись в JSON" Click="LgMenuCopyRowJson_Click"/>
                                    <MenuItem Header="Скопировать Комментарий" Click="LgMenuCopyComment_Click"/>
                                    <Separator Background="{StaticResource HairlineBorder}"/>
                                    <MenuItem Header="Удалить выделенные строки из таблицы" Click="LgMenuDeleteRows_Click" InputGestureText="Delete"/>
                                    <Separator Background="{StaticResource HairlineBorder}"/>
                                    <MenuItem Header="Экспорт в Excel (.xlsx)" Click="LgMenuExportExcel_Click"/>
                                    <MenuItem Header="Открыть подробные детали" Click="LgMenuInspectRow_Click" FontWeight="SemiBold"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата и Время" Binding="{Binding DateFormatted}" SortMemberPath="Date" SortDirection="Descending" Width="180" MinWidth="140"/>
                                <DataGridTextColumn Header="Событие" Binding="{Binding Event}" SortMemberPath="Event" Width="150" MinWidth="110"/>
                                <DataGridTextColumn Header="Важность" Binding="{Binding Importance}" SortMemberPath="Importance" Width="105" MinWidth="85"/>
                                <DataGridTextColumn Header="Пользователь" Binding="{Binding User}" SortMemberPath="User" Width="140" MinWidth="90"/>
                                <DataGridTextColumn Header="Компьютер" Binding="{Binding Computer}" SortMemberPath="Computer" Width="120" MinWidth="90"/>
                                <DataGridTextColumn Header="Приложение" Binding="{Binding App}" SortMemberPath="App" Width="140" MinWidth="100"/>
                                <DataGridTextColumn Header="Метаданные" Binding="{Binding Meta}" SortMemberPath="Meta" Width="165" MinWidth="110"/>
                                <DataGridTextColumn Header="Представление данных" Binding="{Binding DataPresentation}" SortMemberPath="DataPresentation" Width="160" MinWidth="100"/>
                                <DataGridTextColumn Header="Сервер" Binding="{Binding Server}" SortMemberPath="Server" Width="110" MinWidth="85"/>
                                <DataGridTextColumn Header="Сеанс" Binding="{Binding Session}" SortMemberPath="Session" Width="80" MinWidth="60"/>
                                <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" SortMemberPath="FileName" Width="135" MinWidth="95"/>
                                <DataGridTextColumn Header="Размер файла" Binding="{Binding FileSizeFormatted}" SortMemberPath="FileSize" Width="110" MinWidth="85"/>
                                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" SortMemberPath="Comment" Width="*"/>
                                <DataGridTemplateColumn Header="Действия" Width="95" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ДЕТАЛИ" Style="{StaticResource InspectButton}" Click="BtnInspectRow_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Вкладка Настройки и Авторизация -->
                <TabItem Header="НАСТРОЙКИ ПОДКЛЮЧЕНИЯ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- Настройки подключения Elasticsearch & Kibana -->
                            <Border Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ПОДКЛЮЧЕНИЕ И ИНТЕГРАЦИЯ С ELASTICSEARCH &amp; KIBANA" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Адрес Elasticsearch (ServerUrl):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Сетевой адрес и порт ноды Elasticsearch (например: http://localhost:9200). Используется для потоковой отправки логов и аналитики."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtElasticUrl" Grid.Column="1" Text="http://localhost:9200"/>
                                        <Button x:Name="BtnTestElastic" Grid.Column="2" Content="ПРОВЕРИТЬ СВЯЗЬ" Click="BtnTestElastic_Click" Margin="6,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Пользователь (Username):" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                        <TextBox x:Name="TxtElasticUser" Grid.Column="1" Text="elastic"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Пароль (Password):" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                        <PasswordBox x:Name="TxtElasticPass" Grid.Column="1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="API Ключ (ApiKey):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Альтернативный способ аутентификации в Elasticsearch (Base64 токен). Если указан, логин и пароль не требуются."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtElasticApiKey" Grid.Column="1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Адрес Kibana (ServerUrl):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Адрес веб-интерфейса Kibana (по умолчанию http://localhost:5601). Используется для проверки доступности и создания дашбордов."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtKibanaUrl" Grid.Column="1" Text="http://localhost:5601"/>
                                        <Button x:Name="BtnTestKibana" Grid.Column="2" Content="ПРОВЕРИТЬ KIBANA" Click="BtnTestKibana_Click" Margin="6,0,0,0"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="220,4,0,0">
                                        <CheckBox x:Name="ChkElasticEnabled" Content="Включить публикацию в Elasticsearch при мониторинге" Foreground="{StaticResource PulpCream}" IsChecked="True" FontSize="12"/>
                                        <ContentControl Style="{StaticResource InfoBadge}" ToolTip="При включении фоновая служба будет автоматически отправлять новые разобранные записи в Elasticsearch в реальном времени."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Настройки подключения ClickHouse -->
                            <Border Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ПОДКЛЮЧЕНИЕ И ЭКСПОРТ В CLICKHOUSE (HTTP API)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Адрес ClickHouse (ServerUrl):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="HTTP адрес сервера ClickHouse (по умолчанию http://localhost:8123)."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtClickHouseUrl" Grid.Column="1" Text="http://localhost:8123"/>
                                        <Button x:Name="BtnTestClickHouse" Grid.Column="2" Content="ПРОВЕРИТЬ CLICKHOUSE" Click="BtnTestClickHouse_Click" Margin="6,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="База данных (Database):" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                        <TextBox x:Name="TxtClickHouseDb" Grid.Column="1" Text="default"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Пользователь (User):" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                        <TextBox x:Name="TxtClickHouseUser" Grid.Column="1" Text="default"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Пароль (Password):" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                        <PasswordBox x:Name="TxtClickHousePass" Grid.Column="1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Таблица ТЖ (TechLogTable):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Имя таблицы в ClickHouse для логов Технологического Журнала (MergeTree). Создается автоматически при первой отправке."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtClickHouseTechLogTable" Grid.Column="1" Text="techlog"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Таблица ЖР (EventLogTable):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Имя таблицы в ClickHouse для логов Журнала Регистрации (MergeTree). Создается автоматически при первой отправке."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtClickHouseEventLogTable" Grid.Column="1" Text="eventlog"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Размер пачки (BulkBatchSize):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Количество строк/записей, отправляемых в одном HTTP-запросе в ClickHouse (по умолчанию 5000)."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtClickHouseBatchSize" Grid.Column="1" Text="5000"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="220,4,0,0">
                                        <CheckBox x:Name="ChkClickHouseEnabled" Content="Включить экспорт в ClickHouse при мониторинге" Foreground="{StaticResource PulpCream}" IsChecked="False" FontSize="12"/>
                                        <ContentControl Style="{StaticResource InfoBadge}" ToolTip="При включении фоновая служба будет автоматически отправлять новые разобранные записи в ClickHouse в реальном времени."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Префиксы индексов и локальный дамп -->
                            <Border Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ИНДЕКСЫ И ПАРАМЕТРЫ СОХРАНЕНИЯ" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Префикс индекса ТЖ:" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Базовое имя суточных индексов для Технологического Журнала (например: techlog -> 'techlog-2026.08.21')."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtTechLogPrefix" Grid.Column="1" Text="techlog"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Префикс индекса ЖР:" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Базовое имя суточных индексов для Журнала Регистрации (например: events -> 'events-2026.08.21')."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtEventLogPrefix" Grid.Column="1" Text="events"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Каталог дампа ТЖ (techlog):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Каталог для сохранения файлов дампа Технологического Журнала (data_tglog_*.json). ВАЖНО: используйте прямые слеши '/'."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtDumpDirectoryTechLog" Grid.Column="1" Text="C:/1C_Export/json_dump/techlog"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Каталог дампа ЖР (eventlog):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Каталог для сохранения файлов дампа Журнала Регистрации (data_evlog_*.json). ВАЖНО: используйте прямые слеши '/'."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtDumpDirectoryEventLog" Grid.Column="1" Text="C:/1C_Export/json_dump/eventlog"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Макс. сумма дампов (МБ):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Максимальный суммарный размер всех файлов дампа в каждом каталоге (по умолчанию 500 МБ). При превышении старейшие слоты автоматически удаляются."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtDumpMaxTotalSizeMb" Grid.Column="1" Text="500"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Макс. объем полей лога (байты):" Foreground="{StaticResource MidAsh}" FontSize="12"/>
                                            <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Максимальный размер одного текстового поля (SQL-запроса, стека ошибки). Предотвращает переполнение памяти при аномально больших событиях (по умолчанию 65536 байт = 64 КБ)."/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtMaxFieldLength" Grid.Column="1" Text="65536"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Компактный Статус Бар (Superlative Industrial Spec Footer) -->
            <Border Grid.Row="2" Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="12,6" Margin="0,6,0,0" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Статус операции слева с теплым янтарным LED индикатором -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="{StaticResource EmberDiode}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Готов к работе. Выберите каталог ТЖ или ЖР для диагностики." Foreground="{StaticResource PulpCream}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Полоса прогресса в процентах -->
                    <Grid Grid.Column="1" x:Name="PanelProgress" Visibility="Collapsed" Margin="14,0,18,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="0" Background="{StaticResource InkBlack}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" Padding="1" Height="8" Width="180" Margin="0,0,8,0">
                                <ProgressBar x:Name="ProgressBarParsing" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource EmberDiode}" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <TextBlock x:Name="TxtProgressPercent" Text="0%" Foreground="{StaticResource EmberDiode}" FontSize="11.5" FontWeight="SemiBold" Width="40" VerticalAlignment="Center" FontFamily="Consolas, monospace"/>
                            <TextBlock x:Name="TxtProgressDetails" Text="" Foreground="{StaticResource MidAsh}" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="BtnCancelGlobal" Content="ОТМЕНА" Click="BtnCancelParsing_Click" Background="#331414" Foreground="#FFFFFF" BorderBrush="#8A2B2B" BorderThickness="1" Padding="6,2" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Статусная панель справа: Очистка памяти, Версия/Ревизия и Telegram -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Стильный бейдж размера сессионного кэша на диске -->
                        <Border x:Name="BadgeTempSize" Visibility="Collapsed" Height="24" Background="#141414" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="12" Padding="8,0" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="BadgeTempSize_MouseLeftButtonDown" ToolTip="Размер сессионного кэша SQLite WAL на диске. Файл автоматически удаляется при новом разборе или закрытии программы. Нажмите, чтобы открыть папку temp.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾 TEMP: " Foreground="{StaticResource MidAsh}" FontSize="10.5" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTempFileSize" Text="0 Б" Foreground="{StaticResource EmberDiode}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnCleanMemory" Content="СБРОС RAM" Click="BtnCleanMemory_Click" Style="{StaticResource GhostButton}" Height="24" Padding="8,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="10.5" Margin="0,0,8,0" ToolTip="Принудительное освобождение неиспользуемой оперативной памяти и запуск сборщика мусора .NET (GC.Collect)."/>

                        <!-- Стильный бейдж версии и даты сборки -->
                        <Border Height="24" Background="#141414" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="12" Padding="10,0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="v1.8.0" Foreground="{StaticResource Vapor}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAppBuildDate" Text=" • 11.09.2026" Foreground="{StaticResource MidAsh}" FontSize="10.5" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Стильный бейдж Telegram автора -->
                        <Border Height="24" Background="#141414" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="12" Padding="10,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="TgLink_MouseLeftButtonDown" ToolTip="Открыть профиль автора в Telegram: @DarkSailas (https://t.me/DarkSailas)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M20.665,3.717 L2.935,10.554 C1.725,11.04 1.732,11.715 2.713,12.016 L7.265,13.436 L17.797,6.791 C18.295,6.488 18.75,6.651 18.376,6.983 L9.843,14.684 L9.53,19.354 C9.99,19.354 10.193,19.143 10.451,18.894 L12.662,16.744 L17.261,20.141 C18.109,20.608 18.718,20.368 18.929,19.356 L21.948,5.128 C22.257,3.889 21.475,3.328 20.665,3.717 Z" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="@DarkSailas" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY (Superlative Industrial Spec Frame) -->
        <Grid x:Name="OverlayDetails" Visibility="Collapsed" Background="#E6141414" MouseDown="OverlayDetails_MouseDown">
            <Border x:Name="ModalCard" Width="1020" Height="620" MaxWidth="1280" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource ActiveBorder}" BorderThickness="1" CornerRadius="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка модального окна профиля записи -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Верхняя строка: Заголовок слева, кнопки действий справа -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource InkBlack}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="EVENT" Foreground="{StaticResource EmberDiode}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtModalTitle" Text="ДЕТАЛИЗАЦИЯ СОБЫТИЯ 1С" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCopyModalJson" Content="JSON" Click="BtnCopyJson_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,0" ToolTip="Скопировать запись как JSON"/>
                            <Button x:Name="BtnCopyModalContext" Content="КОНТЕКСТ / SQL" Click="BtnCopyModalContext_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,0" ToolTip="Скопировать текст контекста и SQL запроса"/>
                            <Button x:Name="BtnCopyModalAll" Content="СКОПИРОВАТЬ ВСЁ" Click="BtnCopyModalAll_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" ToolTip="Скопировать все свойства и контекст в буфер обмена"/>
                            <Button x:Name="BtnCloseModal" Content="✕" Click="BtnCloseModal_Click" Width="30" Height="30" Padding="0" FontSize="13" FontWeight="SemiBold" Background="{StaticResource InkBlack}" Foreground="{StaticResource Vapor}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Нижняя строка: полный подзаголовок на всю ширину окна -->
                        <TextBlock x:Name="TxtModalSubTitle" Grid.Row="1" Grid.ColumnSpan="2" Text="2026-08-12 09:07:53.205 | Процесс: rphost_27380 (PID 5256)" Foreground="{StaticResource MidAsh}" FontSize="12" Margin="0,6,0,0" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Табы контента модального окна -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <TabItem Header="ФОРМАТИРОВАННЫЙ JSON">
                            <Border Background="{StaticResource InkBlack}" CornerRadius="0" Padding="0" Margin="0,6,0,0" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <TextBox x:Name="TxtModalJson" Style="{StaticResource CodeViewerTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                        </TabItem>

                        <TabItem Header="КОНТЕКСТ &amp; SQL">
                            <Border Background="{StaticResource InkBlack}" CornerRadius="0" Padding="0" Margin="0,6,0,0" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <TextBox x:Name="TxtModalContext" Style="{StaticResource CodeViewerTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                        </TabItem>

                        <TabItem Header="ВСЕ СВОЙСТВА (PROPERTIES)">
                            <Border Background="{StaticResource InkBlack}" CornerRadius="0" Padding="6" Margin="0,6,0,0" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <DataGrid x:Name="GridModalProps" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" MouseRightButtonDown="GridModalProps_MouseRightButtonDown" PreviewKeyDown="GridModalProps_PreviewKeyDown" Background="{StaticResource InkBlack}" RowBackground="#141414" AlternatingRowBackground="#1B1B1B" Foreground="{StaticResource PulpCream}" BorderThickness="0" HeadersVisibility="Column" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Background="#1C1C1C" Foreground="{StaticResource PulpCream}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                            <MenuItem Header="Скопировать значение (Value)" Click="ModalPropsMenuCopyVal_Click" InputGestureText="ПКМ"/>
                                            <MenuItem Header="Скопировать имя свойства (Key)" Click="ModalPropsMenuCopyKey_Click"/>
                                            <MenuItem Header="Скопировать строку (Key = Value)" Click="ModalPropsMenuCopyRow_Click" InputGestureText="Ctrl+C"/>
                                            <Separator Background="{StaticResource HairlineBorder}"/>
                                            <MenuItem Header="Скопировать все свойства как JSON" Click="ModalPropsMenuCopyAllJson_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Свойство (Key)" Binding="{Binding Key}" Width="220" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Значение (Value)" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
