<Window x:Class="OneSLogExporter.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="1С: Log Viewer &amp; Exporter v1.8.0" Height="780" Width="1320"
        MinHeight="540" MinWidth="960" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#141414" Foreground="#FFFFFF"
        FontFamily="Segoe UI, Roboto, sans-serif"
        ToolTipService.InitialShowDelay="2000"
        ToolTipService.ShowDuration="30000"
        ToolTipService.BetweenShowDelay="200"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    
    <Window.Resources>
        <!-- Superlative Industrial Monograph Design Tokens -->
        <SolidColorBrush x:Key="InkBlack" Color="#141414"/>
        <SolidColorBrush x:Key="CharcoalPress" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="StudioSurface" Color="#262626"/>
        <SolidColorBrush x:Key="ElevatedSurface" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="HairlineBorder" Color="#333333"/>
        <SolidColorBrush x:Key="ActiveBorder" Color="#4D4D4D"/>
        
        <!-- Typography -->
        <SolidColorBrush x:Key="Vapor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PulpCream" Color="#F6F4F2"/>
        <SolidColorBrush x:Key="GraphiteVeil" Color="#E4E3E2"/>
        <SolidColorBrush x:Key="MidAsh" Color="#8C8C8C"/>
        
        <!-- Hardware LED Accent -->
        <SolidColorBrush x:Key="EmberDiode" Color="#E66F27"/>
        <SolidColorBrush x:Key="EmberHover" Color="#F08038"/>
        <SolidColorBrush x:Key="EmberDim" Color="#4A250D"/>

        <!-- ContextMenu в стиле Superlative Industrial (0px radius, 1px sharp border) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1C1C1C" BorderBrush="#383838" BorderThickness="1" CornerRadius="0" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="22" SharedSizeGroup="IconGroup"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutGroup"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#8C8C8C" Margin="16,0,4,0" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas, monospace"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Разделитель столбцов таблицы для изменения ширины мышью -->
        <Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки столбцов таблицы DataGrid (Superlative Industrial Spec Header) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,7,12,7"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                    <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="6" Margin="6,0,0,0" VerticalAlignment="Center" Fill="#E66F27" Stretch="Fill" Visibility="Collapsed"/>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#242424"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#222222"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#E66F27"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,6 L 4,0 L 8,6 Z"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#222222"/>
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#E66F27"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,6 L 8,0 Z"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строки и ячейки таблицы DataGrid (Ink Black #141414 / Charcoal #1B1B1B) -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#242424"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Вкладки TabItem (Superlative Industrial Spec Switcher, 3px radius) -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242424"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262626"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox в индустриальном стиле -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="#E66F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="3">
                                            <Border x:Name="splitBorder" Width="20" HorizontalAlignment="Right" BorderBrush="Transparent" BorderThickness="0">
                                                <Path x:Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="F1 M 0,0 L 4,4 L 8,0 Z" Fill="#8C8C8C"/>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="templateRoot" Property="Background" Value="#242424"/>
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#E66F27"/>
                                                <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentTemplate" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="false"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" PopupAnimation="Slide" Placement="Bottom">
                                <Border x:Name="dropDownBorder" Background="#1C1C1C" BorderBrush="#383838" BorderThickness="1" CornerRadius="0" MinWidth="{Binding ActualWidth, ElementName=MainGrid}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поля ввода TextBox и PasswordBox (3px radius, hairline #333333, focus #E66F27) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Многострочный редактор/просмотрщик кода и логов (Top-Left выравнивание) -->
        <Style x:Key="CodeViewerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PulpCream}"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стандартная аппаратная кнопка (Superlative Hardware Button, 3px radius) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#292929"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171717"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button без обводки -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242424"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton меню фильтров (Superlative Spec Switcher) -->
        <Style x:Key="GhostToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262626"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#242424"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#E66F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактная кнопка-переключатель ВКЛЮЧЕНИЯ (ДА / +) для списков фильтрации по полям -->
        <Style x:Key="FilterIncludeToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262626"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4ADE80"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C3824"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#22C55E"/>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактная кнопка-переключатель ИСКЛЮЧЕНИЯ (НЕ / -) для списков фильтрации по полям -->
        <Style x:Key="FilterExcludeToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262626"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D1B16"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#E66F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Superlative Outlined Ghost BUY NOW Spec: 1px border, 3px radius) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E66F27"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E66F27"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F08038"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F08038"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC5D1B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка инспекции строки в таблице (Superlative Spec Button, 3px radius) -->
        <Style x:Key="InspectButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#292929"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E66F27"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Глобальный стиль всплывающих подсказок ToolTip с автоматическим переносом слов -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#F6F4F2"/>
            <Setter Property="BorderBrush" Value="#E66F27"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}" MaxWidth="560">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" FontSize="12" LineHeight="16"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Индикатор / Иконка Справки (InfoBadge) -->
        <Style x:Key="InfoBadge" TargetType="ContentControl">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="2000"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Bd" Background="#222222" BorderBrush="#444444" BorderThickness="1" CornerRadius="7">
                            <TextBlock Text="i" Foreground="{StaticResource MidAsh}" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI, Tahoma, sans-serif" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#332218"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E66F27"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стилизация элементов управления Календаря (Superlative Dark High-Contrast) -->
        <Style x:Key="CalendarHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0EDE6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F0EDE6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarDayButtonStyle" TargetType="primitives:CalendarDayButton">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:CalendarDayButton">
                        <Grid>
                            <Border x:Name="DayBg" Background="Transparent" CornerRadius="2" Margin="1"/>
                            <ContentPresenter x:Name="DayContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="1"
                                              TextElement.Foreground="#FFFFFF"
                                              TextElement.FontWeight="Normal"
                                              TextElement.FontSize="11.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="DayContent" Property="TextElement.Foreground" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBg" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayBg" Property="BorderBrush" Value="{StaticResource EmberDiode}"/>
                                <Setter TargetName="DayBg" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBg" Property="Background" Value="{StaticResource EmberDiode}"/>
                                <Setter TargetName="DayContent" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="DayContent" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter TargetName="DayContent" Property="TextElement.Foreground" Value="#333333"/>
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarButtonStyle" TargetType="primitives:CalendarButton">
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:CalendarButton">
                        <Grid>
                            <Border x:Name="BtnBg" Background="Transparent" CornerRadius="2" Margin="1"/>
                            <ContentPresenter x:Name="BtnTxt" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              TextElement.Foreground="#FFFFFF" 
                                              TextElement.FontSize="11.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="BtnTxt" Property="TextElement.Foreground" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{StaticResource EmberDiode}"/>
                                <Setter TargetName="BtnTxt" Property="TextElement.Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="BtnTxt" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarItemStyle" TargetType="primitives:CalendarItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:CalendarItem">
                        <ControlTemplate.Resources>
                            <!-- Стиль заголовков дней недели (п в с ч п с в) -->
                            <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}" 
                                           Foreground="#F0EDE6" 
                                           Opacity="0.9"
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Margin="0,2,0,4"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <Border Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" Padding="4">
                            <Grid x:Name="PART_Root">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Шапка: Месяц Год и стрелки -->
                                <Grid Grid.Row="0" Margin="2,2,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="◀" Style="{StaticResource CalendarArrowButtonStyle}" Focusable="False"/>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource CalendarHeaderButtonStyle}" Focusable="False"/>
                                    <Button x:Name="PART_NextButton" Grid.Column="2" Content="▶" Style="{StaticResource CalendarArrowButtonStyle}" Focusable="False"/>
                                </Grid>

                                <!-- Сетка дней месяца -->
                                <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!-- Сетка месяцев года -->
                                <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource DarkCalendarItemStyle}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButtonStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <primitives:CalendarItem x:Name="PART_CalendarItem"
                                                 Style="{TemplateBinding CalendarItemStyle}"
                                                 Background="{TemplateBinding Background}"
                                                 BorderBrush="{TemplateBinding BorderBrush}"
                                                 BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Calendar" BasedOn="{StaticResource DarkCalendarStyle}"/>
    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна (Superlative Industrial Spec Header) -->
            <Border Grid.Row="0" Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#141414" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="15" Padding="9,2" Margin="0,0,10,0">
                            <TextBlock Text="1C LOGS" Foreground="{StaticResource EmberDiode}" FontWeight="SemiBold" FontSize="10"/>
                        </Border>
                        <TextBlock Text="1С: Log Viewer &amp; Exporter" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" VerticalAlignment="Center"/>
                        <TextBlock Text="— Мониторинг, анализ и экспорт технологического журнала и журнала регистрации" FontSize="11.5" Foreground="{StaticResource MidAsh}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnImportProfile" Content="ИМПОРТ ПРОФИЛЯ" Click="BtnImportProfile_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,0" ToolTip="Импортировать фильтры и настройки из JSON-файла"/>
                        <Button x:Name="BtnExportProfile" Content="ЭКСПОРТ ПРОФИЛЯ" Click="BtnExportProfile_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,0" ToolTip="Экспортировать текущие фильтры и настройки в JSON-файл"/>
                        <Button x:Name="BtnSaveConfig" Content="СОХРАНИТЬ НАСТРОЙКИ" Click="BtnSaveConfig_Click" ToolTip="Сохранить текущие параметры конфигурации и профиль"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основной Контент с Вкладками -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <!-- Вкладка Технологический Журнал (ТЖ) -->
                <TabItem Header="ТЕХНОЛОГИЧЕСКИЙ ЖУРНАЛ (ТЖ)">
                    <Grid Margin="0,6,0,0" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель Загрузки и Парсинга ТЖ -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="ПУТЬ К ТЖ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Каталог или отдельный файл логов ТЖ (*.log, *.txt). Поддерживается произвольная вложенность подпапок и прямое указание одного файла."/>
                            </StackPanel>
                            <TextBox x:Name="TxtTgPath" Grid.Column="1" Text="C:\Logs\TGLogs" VerticalAlignment="Center" AllowDrop="True" PreviewDragOver="TxtPath_PreviewDragOver" Drop="TxtTgPath_Drop" ToolTip="Укажите каталог или отдельный файл логов ТЖ (*.log, *.txt). Поддерживается Drag and Drop."/>
                            <Button x:Name="BtnBrowseTg" Grid.Column="2" Content="ОБЗОР ▾" Click="BtnBrowseTg_Click" Style="{StaticResource GhostButton}" Margin="6,0,0,0" ToolTip="Выбрать каталог или отдельный файл лога ТЖ">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📁 Выбрать каталог (папку)..." Click="MenuItemBrowseTgFolder_Click"/>
                                        <MenuItem Header="📄 Выбрать файл лога (*.log, *.txt)..." Click="MenuItemBrowseTgFile_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                <TextBlock Text="ЛИМИТ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold"/>
                                <ContentControl Style="{StaticResource InfoBadge}" ToolTip="Ограничение количества загружаемых строк для быстрого просмотра и мгновенной диагностики без перегрузки оперативной памяти."/>
                            </StackPanel>
                            <ComboBox x:Name="CmbTgLimit" Grid.Column="4" Width="110" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="CmbTgLimit_SelectionChanged">
                                <ComboBoxItem Content="Все записи"/>
                                <ComboBoxItem Content="1 000"/>
                                <ComboBoxItem Content="5 000"/>
                                <ComboBoxItem Content="10 000"/>
                                <ComboBoxItem Content="50 000"/>
                                <ComboBoxItem Content="100 000"/>
                                <ComboBoxItem Content="500 000"/>
                                <ComboBoxItem Content="1 000 000"/>
                            </ComboBox>
                            <Button x:Name="BtnParseTg" Grid.Column="5" Content="РАСПАРСИТЬ ТЖ" Click="BtnParseTg_Click" Style="{StaticResource PrimaryButton}" ToolTip="Запустить высокоскоростной параллельный разбор файлов Технологического Журнала" Margin="6,0,0,0"/>
                            <Button x:Name="BtnCancelTg" Grid.Column="6" Content="ОСТАНОВИТЬ" Click="BtnCancelParsing_Click" Visibility="Collapsed" Background="#331414" Foreground="#FFFFFF" BorderBrush="#8A2B2B" BorderThickness="1" Padding="12,5" ToolTip="Остановить выполнение операции парсинга" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportTgJson" Grid.Column="7" Content="JSON" Click="BtnExportTgJson_Click" ToolTip="Экспорт выделенных строк (или всей таблицы) ТЖ в JSON" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportTgExcel" Grid.Column="8" Content="EXCEL" Click="BtnExportTgExcel_Click" ToolTip="Экспорт таблицы ТЖ в файл Microsoft Excel (.xlsx)" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportTgElastic" Grid.Column="9" Content="ELASTIC" Click="BtnExportTgElastic_Click" ToolTip="Экспортировать текущие отображаемые записи таблицы напрямую в кластер Elasticsearch" Margin="6,0,0,0"/>
                            <Button x:Name="BtnExportTgClickHouse" Grid.Column="10" Content="CLICKHOUSE" Click="BtnExportTgClickHouse_Click" ToolTip="Экспортировать текущие отображаемые записи таблицы напрямую в ClickHouse" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Панель Поиска, Фильтров и Сортировки ТЖ -->
                        <Border Grid.Row="1" Background="{StaticResource CharcoalPress}" CornerRadius="0" Padding="10,8" Margin="0,0,0,8" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="80" MaxWidth="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Быстрый Поиск с поддержкой исключений '!' и '-' -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox x:Name="TxtTgFilter" TextChanged="TxtTgFilter_TextChanged" Padding="8,6,8,6" FontSize="12" ToolTip="Быстрый поиск по всем полям. Для исключения используйте ! или - (например: !ATTN, -ragent, !Администратор)"/>
                                    </Grid>

                                    <!-- 2. Фильтр по времени (С / По) и Календарь периода -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="ВРЕМЯ:" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                        <TextBlock Text="с" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" Margin="0,0,2,0"/>
                                        <TextBox x:Name="TxtTgTimeFrom" TextChanged="TxtTgTimeFilter_TextChanged" Width="72" ToolTip="Время С (например 16:13:00, 16:13 или 2026-08-17 16:13)" FontSize="12" Padding="4,4"/>
                                        <TextBlock Text="по" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" Margin="4,0,2,0"/>
                                        <TextBox x:Name="TxtTgTimeTo" TextChanged="TxtTgTimeFilter_TextChanged" Width="72" ToolTip="Время ПО (например 16:15:00 или 16:15)" FontSize="12" Padding="4,4"/>

                                        <!-- Интерактивный Календарь ТЖ с пресетами -->
                                        <ToggleButton x:Name="BtnTgCalendarMenu" Content="📅 КАЛЕНДАРЬ ▼" Style="{StaticResource GhostToggleButton}" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click" ToolTip="Интерактивный календарь и быстрый выбор диапазона дат ТЖ"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnTgCalendarMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnTgCalendarMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,4,0,0">
                                                <StackPanel Width="260">
                                                    <Grid Margin="0,0,0,6">
                                                        <TextBlock Text="ВЫБОР ПЕРИОДА" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button HorizontalAlignment="Right" Content="СБРОСИТЬ" Click="BtnTgCalendarClear_Click" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10"/>
                                                    </Grid>

                                                    <!-- Подсказка двухкликового выбора периода -->
                                                    <TextBlock x:Name="TxtTgCalendarHint" Text="Кликните дату начала и дату окончания" Foreground="{StaticResource MidAsh}" FontSize="10.5" FontStyle="Italic" Margin="0,0,0,6"/>

                                                    <WrapPanel Margin="0,0,0,6">
                                                        <Button Content="Сегодня" Click="BtnTgPresetToday_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="Вчера" Click="BtnTgPresetYesterday_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="3 дня" Click="BtnTgPreset3Days_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="7 дней" Click="BtnTgPreset7Days_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="30 дней" Click="BtnTgPreset30Days_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="Этот месяц" Click="BtnTgPresetThisMonth_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,3,3"/>
                                                        <Button Content="Все логи" Click="BtnTgPresetAllLogs_Click" Style="{StaticResource GhostButton}" Padding="5,2" FontSize="10" Margin="0,0,0,3"/>
                                                    </WrapPanel>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,4,0">
                                                            <TextBlock Text="Дата С:" Foreground="{StaticResource MidAsh}" FontSize="10.5" Margin="0,0,0,2"/>
                                                            <TextBox x:Name="TxtTgDateFrom" TextChanged="TxtTgDate_TextChanged" GotFocus="TxtTgDate_GotFocus" Padding="6,4" FontSize="11" ToolTip="Дата С в формате ДД.ММ.ГГГГ (например 26.08.2026)"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="Дата ПО:" Foreground="{StaticResource MidAsh}" FontSize="10.5" Margin="0,0,0,2"/>
                                                            <TextBox x:Name="TxtTgDateTo" TextChanged="TxtTgDate_TextChanged" GotFocus="TxtTgDate_GotFocus" Padding="6,4" FontSize="11" ToolTip="Дата ПО в формате ДД.ММ.ГГГГ (например 30.08.2026)"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Calendar x:Name="CalTgRange" Style="{StaticResource DarkCalendarStyle}" SelectionMode="SingleRange" SelectedDatesChanged="CalTgRange_SelectedDatesChanged" PreviewMouseUp="CalTgRange_PreviewMouseUp" GotMouseCapture="Calendar_GotMouseCapture" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="ПРИМЕНИТЬ" Click="BtnTgCalendarApply_Click" Style="{StaticResource PrimaryButton}" Padding="12,5" HorizontalAlignment="Left"/>
                                                        <Button Grid.Column="1" Content="ЗАКРЫТЬ" Click="BtnTgCalendarClose_Click" Style="{StaticResource GhostButton}" Padding="10,5"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 3. Основной фильтр событий 1С -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="СОБЫТИЕ:" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CmbTgEventFilter" SelectionChanged="CmbTgEventFilter_SelectionChanged" Width="195" SelectedIndex="0">
                                            <ComboBoxItem Content="Все события 1С"/>
                                            <ComboBoxItem Content="Ошибки (EXCP / EXCPCNTX / QERR)"/>
                                            <ComboBoxItem Content="Блокировки (TLOCK / TDEADLOCK / TTIMEOUT)"/>
                                            <ComboBoxItem Content="Запросы СУБД (DBMSSQL / SDBL / DBPOSTGRS)"/>
                                            <ComboBoxItem Content="Вызовы (CALL / SCALL / RUNMETH)"/>
                                            <ComboBoxItem Content="Длительные (LONGDURATIONINFO)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 4. Меню Включающих Параметров Фильтрации -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnTgFilterMenu" Content="ДОП. ФИЛЬТРЫ ▼" Style="{StaticResource GhostToggleButton}" Padding="9,5" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnTgFilterMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnTgFilterMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,4,0,0">
                                                <StackPanel Width="360">
                                                    <TextBlock Text="ДОПОЛНИТЕЛЬНЫЕ ПАРАМЕТРЫ ФИЛЬТРАЦИИ ТЖ" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" Margin="0,0,0,10"/>

                                                    <TextBlock Text="СТАТУС ВЫПОЛНЕНИЯ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <WrapPanel Margin="0,0,0,10">
                                                        <CheckBox x:Name="ChkTgIncRunning" Content="Выполняются (LONGDURATION)" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkTgFilter_Click"/>
                                                        <CheckBox x:Name="ChkTgIncCompleted" Content="Завершенные" Foreground="{StaticResource Vapor}" Margin="0,0,0,4" Click="ChkTgFilter_Click"/>
                                                    </WrapPanel>

                                                    <TextBlock Text="МИНИМАЛЬНАЯ ДЛИТЕЛЬНОСТЬ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbTgMinDuration" SelectionChanged="CmbTgMinDuration_SelectionChanged" SelectedIndex="0" Margin="0,0,0,10">
                                                        <ComboBoxItem Content="Любая длительность (без порога)"/>
                                                        <ComboBoxItem Content="Дольше 10 мс"/>
                                                        <ComboBoxItem Content="Дольше 100 мс"/>
                                                        <ComboBoxItem Content="Дольше 1 сек"/>
                                                        <ComboBoxItem Content="Дольше 5 сек"/>
                                                        <ComboBoxItem Content="Дольше 10 сек"/>
                                                    </ComboBox>

                                                    <TextBlock Text="СОРТИРОВКА ТАБЛИЦЫ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbTgSortPreset" SelectionChanged="CmbTgSortPreset_SelectionChanged" SelectedIndex="0">
                                                        <ComboBoxItem Content="Дата (сначала новые)"/>
                                                        <ComboBoxItem Content="Дата (сначала старые)"/>
                                                        <ComboBoxItem Content="Длительность (сначала долгие)"/>
                                                        <ComboBoxItem Content="Длительность + Новые дата"/>
                                                        <ComboBoxItem Content="Событие + Длительность"/>
                                                        <ComboBoxItem Content="Пользователь + Дата"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 5. Меню Исключающих Фильтров (НЕ) с множественным выбором -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnTgExcludeMenu" Content="ИСКЛЮЧЕНИЯ (НЕ) ▼" Style="{StaticResource GhostToggleButton}" Padding="9,5" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnTgExcludeMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnTgExcludeMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,4,0,0">
                                                <StackPanel Width="420">
                                                    <TextBlock Text="ИСКЛЮЧЕНИЕ ДАННЫХ ИЗ ТАБЛИЦЫ (ФИЛЬТРЫ НЕ)" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" Margin="0,0,0,10"/>

                                                    <!-- Шапка секции событий с поиском и кнопками -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Исключить события 1С:" VerticalAlignment="Center" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="СНЯТЬ ВСЕ" Click="BtnTgExcludeClearAll_Click" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBox x:Name="TxtTgExcludeEventSearch" TextChanged="TxtTgExcludeEventSearch_TextChanged" Padding="8,4" Margin="0,0,0,6" FontSize="11.5" ToolTip="Фильтр по списку событий..."/>

                                                    <!-- Скроллируемый список событий с чекбоксами -->
                                                    <Border Background="{StaticResource CharcoalPress}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Height="190" Margin="0,0,0,10">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl x:Name="ListTgExcludeEvents" Margin="6,4">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,3" Click="ChkTgExcludeEventItem_Click">
                                                                            <CheckBox.Content>
                                                                                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Vapor}"/>
                                                                                    <Run Text=" — " Foreground="{StaticResource MidAsh}"/>
                                                                                    <Run Text="{Binding Subtitle}" Foreground="{StaticResource MidAsh}" FontSize="11"/>
                                                                                </TextBlock>
                                                                            </CheckBox.Content>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>

                                                    <!-- Исключение процессов -->
                                                    <TextBlock Text="ИСКЛЮЧИТЬ ПРОЦЕССЫ 1С:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <WrapPanel Margin="0,0,0,10">
                                                        <CheckBox x:Name="ChkTgExRphost" Content="rphost" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkTgFilter_Click"/>
                                                        <CheckBox x:Name="ChkTgExRmngr" Content="rmngr" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkTgFilter_Click"/>
                                                        <CheckBox x:Name="ChkTgExRagent" Content="ragent" Foreground="{StaticResource Vapor}" Margin="0,0,0,4" Click="ChkTgFilter_Click"/>
                                                    </WrapPanel>

                                                    <!-- Исключение статусов -->
                                                    <TextBlock Text="ИСКЛЮЧИТЬ СТАТУСЫ ОПЕРАЦИЙ:" Foreground="{StaticResource MidAsh}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <WrapPanel Margin="0,0,0,10">
                                                        <CheckBox x:Name="ChkTgExCompleted" Content="Завершенные" Foreground="{StaticResource Vapor}" Margin="0,0,12,4" Click="ChkTgFilter_Click"/>
                                                        <CheckBox x:Name="ChkTgExRunning" Content="Выполняющиеся" Foreground="{StaticResource Vapor}" Margin="0,0,0,4" Click="ChkTgFilter_Click"/>
                                                    </WrapPanel>

                                                    <!-- Памятка по строке поиска -->
                                                    <Border Background="#141414" CornerRadius="0" Padding="8,6" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                                        <TextBlock Foreground="{StaticResource MidAsh}" FontSize="11" TextWrapping="Wrap" LineHeight="15">
                                                            <Run FontWeight="SemiBold" Foreground="{StaticResource Vapor}">РУЧНЫЕ ИСКЛЮЧЕНИЯ:</Run> вводите в поиск <Run FontWeight="Bold" Foreground="{StaticResource EmberDiode}">!</Run> перед словом (например <Run Foreground="{StaticResource Vapor}">!DefUser</Run>, <Run Foreground="{StaticResource Vapor}">!1Cv8C</Run>, <Run Foreground="{StaticResource Vapor}">!ServerJobExecutorContext</Run>).
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <!-- 6. Меню Отбора по заполненным полям ТЖ (Пользователи, Приложения, PID, SPID, OSThread) -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ToggleButton x:Name="BtnTgFieldsMenu" Content="ОТБОР ПО ПОЛЯМ ▼" Style="{StaticResource GhostToggleButton}" Padding="9,5" PreviewMouseLeftButtonDown="MenuToggleButton_PreviewMouseLeftButtonDown" Click="MenuToggleButton_Click"/>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=BtnTgFieldsMenu}" StaysOpen="False" Closed="MenuPopup_Closed" PlacementTarget="{Binding ElementName=BtnTgFieldsMenu}" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="{StaticResource StudioSurface}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,4,0,0">
                                                <StackPanel Width="560">
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="ОТБОР ЗАПИСЕЙ ТЖ ПО ПОЛЯМ" FontWeight="SemiBold" Foreground="{StaticResource Vapor}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="СБРОСИТЬ ВСЕ" Click="BtnTgClearAllFieldFilters_Click" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10"/>
                                                    </Grid>

                                                    <TabControl Background="Transparent" BorderThickness="0" Height="270">
                                                        <TabItem Header="ПОЛЬЗОВАТЕЛИ">
